worker_processes  1;

events {
    worker_connections  1024;
}

http {
    include       mime.types;
    default_type  application/octet-stream;
    sendfile        on;
    keepalive_timeout  65;

    # Редирект HTTP → HTTPS
    server {
        listen 80;
        server_name localhost;
        return 301 https://$host$request_uri;
    }

    # HTTPS сервер
    server {
        listen 443 ssl;
        server_name localhost;

        ssl_certificate     C:/nginx-1.30.0/nginx-1.30.0/localhost+2.pem;
        ssl_certificate_key C:/nginx-1.30.0/nginx-1.30.0/localhost+2-key.pem;
        ssl_protocols       TLSv1.2 TLSv1.3;
        ssl_ciphers         HIGH:!aNULL:!MD5;
        ssl_prefer_server_ciphers on;

        client_max_body_size 50M;

        # === НОВЫЙ БЛОК: раздача файлов ===
        location /storage/uploads/ {
    alias "C:/Users/user/OneDrive/Рабочий стол/SECURECHAT/backend/storage/uploads/";
    client_max_body_size 50M;  # Размер файлов хранеия 
}

        # FastAPI (REST API)
        location /api/v1/ {
            proxy_pass http://127.0.0.1:8000;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            client_max_body_size 50M; # размер для скачивания 
        }

        # FastAPI (WebSocket)
        location /api/v1/ws/ {
            proxy_pass http://127.0.0.1:8000;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
            proxy_set_header Host $host;
        }

        # Django (Frontend)
        location / {
            proxy_pass http://127.0.0.1:9000;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            client_max_body_size 50M;
        }

        error_page 500 502 503 504 /50x.html;
        location = /50x.html {
            root html;
        }
    }
}